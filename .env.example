# ─── Firebase web SDK (public, safe for the browser) ─────────────────────────
# Firebase console → Project settings → General → Your apps → SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Socket.IO server ────────────────────────────────────────────────────────
# Port the standalone game server listens on (the dev proxy forwards /socket.io here).
SOCKET_PORT=4001
# Comma-separated browser origins allowed to talk to the socket server directly.
# Leave as localhost when using the bundled dev proxy (single origin).
CLIENT_ORIGIN=http://localhost:3000

# Leave empty to connect same-origin (recommended: dev proxy / production reverse proxy).
# Set only when the socket server is exposed on its own origin, e.g. http://localhost:4001.
NEXT_PUBLIC_SOCKET_URL=

# ─── Firebase Admin (server-only, never expose to the browser) ───────────────
# Service-account JSON pasted on a single line (Project settings → Service accounts).
FIREBASE_SERVICE_ACCOUNT=
# …or point at a service-account key file instead of the inline JSON.
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Development only ────────────────────────────────────────────────────────
# Accepts `dev:<uid>:<name>` tokens instead of Firebase ID tokens. Hard-disabled
# when NODE_ENV=production. Never enable on a public deployment.
ALLOW_DEV_AUTH=0
# Shows a guest sign-in button that uses the dev token above.
NEXT_PUBLIC_DEMO_MODE=0
