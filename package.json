{
  "name": "chesskings",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,socket,proxy -c cyan,magenta,yellow \"npm:dev:web\" \"npm:dev:socket\" \"npm:dev:proxy\"",
    "dev:demo": "ALLOW_DEV_AUTH=1 NEXT_PUBLIC_DEMO_MODE=1 npm run dev",
    "dev:web": "next dev -p 3001",
    "dev:socket": "tsx watch server/index.ts",
    "dev:proxy": "tsx watch scripts/dev-proxy.ts",
    "build": "next build",
    "start": "tsx server/index.ts",
    "start:socket": "tsx server/index.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "dotenv": "^18.0.10",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-chessboard": "^5.12.1",
    "react-dom": "19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "stockfish.js": "^10.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
